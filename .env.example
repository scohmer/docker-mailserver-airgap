# =============================================================================
# docker-mailserver - environment configuration (FIPS-hardened / air-gapped)
# TEMPLATE: cp .env.example .env && chmod 600 .env   (.env is gitignored)
# =============================================================================
# This file is used twice:
#   1. by compose for ${VAR} interpolation in docker-compose.yml
#   2. by the container itself (env_file: .env)
#
# Rules:
#   * An EMPTY value means "use the DMS default".
#   * Do not quote values. Do not put spaces around "=".
#   * A literal "$" in a value must be written as "$$" (compose interpolation).
#   * Variables differ between DMS releases. After choosing DMS_IMAGE, diff
#     this file against the mailserver.env shipped with THAT release tag
#     (see setup-instructions.md, section 2.3).
#   * Values chosen here are the hardened, offline-safe choice. Comments note
#     the DMS default where it differs.
#
# chmod 600 this file - it may contain LDAP/relay credentials.
# =============================================================================


# -----------------------------------------------------------------------------
# 0. Compose / host-side settings (not used by DMS itself)
# -----------------------------------------------------------------------------

# Image to run. Use the upstream tag you transferred, OR the locally built
# FIPS-provider image (setup-instructions.md section 4, Option B).
#   Option A: ghcr.io/docker-mailserver/docker-mailserver:16.0.1
#   Option B: localhost/docker-mailserver-fips:16.0.1
# Never use :latest or :edge.
DMS_IMAGE=localhost/docker-mailserver-fips:16.0.1

DMS_CONTAINER_NAME=mailserver

# Fully-qualified host name of the mail server (must have A + PTR records).
MAIL_FQDN=mail.example.internal

# Primary mail domain (used for DNS search domain).
MAIL_DOMAIN=example.internal

# Host IP address to publish ports on. Use a specific interface IP, not 0.0.0.0.
MAIL_BIND_IP=10.0.0.25

# Internal DNS resolvers (repeat the first one if you only have one).
DNS_SERVER_1=10.0.0.53
DNS_SERVER_2=10.0.0.54

# Container network subnet - must not overlap enclave address space.
MAIL_NET_SUBNET=172.31.250.0/24

# Host directory holding mail-data, mail-state, mail-logs, config, certs, ca, fips.
DMS_DATA_ROOT=./docker-data/dms


# -----------------------------------------------------------------------------
# 1. General
# -----------------------------------------------------------------------------

# Overrides the container hostname as seen by DMS (normally leave empty and
# set MAIL_FQDN above instead).
OVERRIDE_HOSTNAME=

# critical | error | warn | info | debug | trace
LOG_LEVEL=info

# Supervisor log level: critical | error | warn | info | debug (empty = warn)
SUPERVISOR_LOGLEVEL=

# UID/GID owning mailboxes (default 5000). Pin it so host-side backups and
# file permissions are predictable.
DMS_VMAIL_UID=5000
DMS_VMAIL_GID=5000

# FILE (default, accounts in config/postfix-accounts.cf) | LDAP
ACCOUNT_PROVISIONER=FILE

# Address that receives postmaster / system notices (empty = postmaster@<domain>).
POSTMASTER_ADDRESS=postmaster@example.internal

# DMS phones home to GitHub to check for new releases. MUST be 0 offline.
ENABLE_UPDATE_CHECK=0
UPDATE_CHECK_INTERVAL=1d

# Which networks are trusted to relay WITHOUT authentication:
#   none (hardened) | container | host | network | connected-networks
PERMIT_DOCKER=none

# Time zone (empty = UTC). UTC is recommended for log correlation.
TZ=UTC

# Interface DMS uses to detect its own IP (empty = eth0).
NETWORK_INTERFACE=

# modern = TLS 1.2+ only, AEAD ciphers. Further narrowed to FIPS-approved
# suites by config/postfix-main.cf, config/dovecot.cf and fips/openssl.cnf.
TLS_LEVEL=modern

# 1 = authenticated users may only send as addresses they own. (default 0)
SPOOF_PROTECTION=1

# Sender Rewriting Scheme - only needed if you forward mail to other domains.
ENABLE_SRS=0
SRS_SENDER_CLASSES=envelope_sender
SRS_EXCLUDE_DOMAINS=
# Leave empty to auto-generate (stored in mail-state).
SRS_SECRET=


# -----------------------------------------------------------------------------
# 2. Protocols / services
# -----------------------------------------------------------------------------

ENABLE_IMAP=1
# POP3 disabled (default 0). Never publish 110/995 unless required.
ENABLE_POP3=0
# Sieve script management over port 4190 (also uncomment it in compose).
ENABLE_MANAGESIEVE=0
# 1 = disable IMAP/POP3 entirely (send-only relay).
SMTP_ONLY=0

# Which IP family Postfix / Dovecot listen on: all | ipv4 | ipv6
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4


# -----------------------------------------------------------------------------
# 3. TLS certificates
# -----------------------------------------------------------------------------
# letsencrypt is impossible offline; use your internal PKI.
#   manual | self-signed | letsencrypt | custom | (empty = no TLS - NEVER)
SSL_TYPE=manual

# Paths are INSIDE the container (compose mounts ${DMS_DATA_ROOT}/certs here).
# Key: RSA >= 3072 or ECDSA P-384 (P-256 acceptable). Chain = leaf + intermediates.
SSL_CERT_PATH=/etc/dms/certs/fullchain.pem
SSL_KEY_PATH=/etc/dms/certs/privkey.pem

# Optional second (dual) certificate, e.g. ECDSA alongside RSA.
SSL_ALT_CERT_PATH=
SSL_ALT_KEY_PATH=


# -----------------------------------------------------------------------------
# 4. Mail authentication (DKIM / DMARC / SPF)
# -----------------------------------------------------------------------------
# Classic stack. Disable all three if you switch to Rspamd (section 7).

# DKIM signing/verification (RSA-SHA256 via OpenSSL -> inside FIPS boundary).
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1


# -----------------------------------------------------------------------------
# 5. Anti-virus (ClamAV via Amavis)
# -----------------------------------------------------------------------------
# Signatures must be refreshed offline (setup-instructions.md section 8).
# Needs ~1.5 GB extra RAM. With the FIPS image, ClamAV runs under a scoped
# non-FIPS OpenSSL config (setup-instructions.md §4.5).
ENABLE_CLAMAV=1
CLAMAV_MESSAGE_SIZE_LIMIT=25M

ENABLE_AMAVIS=1
# 0-5
AMAVIS_LOGLEVEL=0

# Days to keep quarantined virus mails (default 7).
VIRUSMAILS_DELETE_DELAY=30


# -----------------------------------------------------------------------------
# 6. Anti-spam - SpamAssassin (via Amavis)
# -----------------------------------------------------------------------------
# Off by default: rule updates (sa-update) need the internet, so they must be
# sneakernetted in. Enable only if your enclave receives untrusted mail.
ENABLE_SPAMASSASSIN=0
# KAM third-party ruleset - downloads from the internet. Keep 0.
ENABLE_SPAMASSASSIN_KAM=0
SPAMASSASSIN_SPAM_TO_INBOX=1
MOVE_SPAM_TO_JUNK=1
MARK_SPAM_AS_READ=0
SA_TAG=2.0
SA_TAG2=6.31
SA_KILL=10.0
# Subject prefix for spam.
SPAM_SUBJECT=***SPAM***


# -----------------------------------------------------------------------------
# 7. Anti-spam - Rspamd (alternative to sections 4 + 6)
# -----------------------------------------------------------------------------
# Rspamd has several modules that reach out to the internet (maps, fuzzy
# storage, RBLs). If you enable it, follow section 7 of the instructions.
ENABLE_RSPAMD=0
ENABLE_RSPAMD_REDIS=
RSPAMD_LEARN=0
RSPAMD_CHECK_AUTHENTICATED=0
RSPAMD_GREYLISTING=0
RSPAMD_HFILTER=1
RSPAMD_HFILTER_HOSTNAME_UNKNOWN_SCORE=6
RSPAMD_NEURAL=0


# -----------------------------------------------------------------------------
# 8. Connection filtering
# -----------------------------------------------------------------------------

# DNS blocklists (Spamhaus etc.) are internet services. MUST be 0 offline.
ENABLE_DNSBL=0

# Postscreen action on bad clients: enforce | drop | ignore
POSTSCREEN_ACTION=enforce

# Reject clients without valid reverse DNS (0 = off). Enable only if your
# internal DNS has complete PTR coverage.
POSTFIX_REJECT_UNKNOWN_CLIENT_HOSTNAME=0

# Greylisting - rarely useful inside an enclave.
ENABLE_POSTGREY=0
POSTGREY_DELAY=300
POSTGREY_MAX_AGE=35
POSTGREY_TEXT=Delayed by Postgrey
POSTGREY_AUTO_WHITELIST_CLIENTS=5

# Fail2Ban (needs cap NET_ADMIN, set in compose).
ENABLE_FAIL2BAN=1
# drop | reject
FAIL2BAN_BLOCKTYPE=drop

# MTA-STS needs HTTPS policy fetches from remote domains. Keep 0 offline.
ENABLE_MTA_STS=0


# -----------------------------------------------------------------------------
# 9. Message handling / quotas
# -----------------------------------------------------------------------------

# Delivery agent override (empty = Dovecot LMTP). Leave empty.
POSTFIX_DAGENT=
# Mailbox size limit in bytes (0 = unlimited). Example: 5 GiB.
POSTFIX_MAILBOX_SIZE_LIMIT=5368709120
# Per-user quotas via Dovecot (requires FILE or LDAP provisioner).
ENABLE_QUOTAS=1
# Max message size in bytes (default 10240000). Example: 25 MiB.
POSTFIX_MESSAGE_SIZE_LIMIT=26214400

# maildir | sdbox | mdbox
DOVECOT_MAILBOX_FORMAT=maildir


# -----------------------------------------------------------------------------
# 10. Reports / logs
# -----------------------------------------------------------------------------

# Postfix log summary: daily_cron | logrotate | none (empty = none)
PFLOGSUMM_TRIGGER=
PFLOGSUMM_RECIPIENT=
PFLOGSUMM_SENDER=

# Logwatch: daily | weekly | none
LOGWATCH_INTERVAL=none
LOGWATCH_RECIPIENT=
LOGWATCH_SENDER=

# Defaults for the two report recipients/senders above.
REPORT_RECIPIENT=
REPORT_SENDER=

# Rotation of /var/log/mail inside the container: daily | weekly | monthly
LOGROTATE_INTERVAL=daily
# Number of rotated logs kept. Align with your audit retention policy
# (host journald/SIEM is the authoritative copy).
LOGROTATE_COUNT=90


# -----------------------------------------------------------------------------
# 11. Outbound relay (smart host / enclave mail gateway)
# -----------------------------------------------------------------------------
# Leave empty if this server delivers directly to other internal MTAs.
# Format: [host]:port   (brackets suppress MX lookup)
DEFAULT_RELAY_HOST=
# Legacy relay variables (deprecated in newer releases, still read by some).
RELAY_HOST=
RELAY_PORT=25
RELAY_USER=
RELAY_PASSWORD=


# -----------------------------------------------------------------------------
# 12. Fetchmail / Getmail (pull mail from remote mailboxes) - off
# -----------------------------------------------------------------------------
ENABLE_FETCHMAIL=0
FETCHMAIL_POLL=300
FETCHMAIL_PARALLEL=0
ENABLE_GETMAIL=0
GETMAIL_POLL=5


# -----------------------------------------------------------------------------
# 13. LDAP / Active Directory (ACCOUNT_PROVISIONER=LDAP)
# -----------------------------------------------------------------------------
# Recommended for enclaves: passwords are verified by the directory (via a
# Dovecot auth bind) instead of being hashed and stored in DMS. Always ldaps://
# or LDAP_START_TLS=yes. The CA must be in ${DMS_DATA_ROOT}/ca/.
LDAP_START_TLS=no
LDAP_SERVER_HOST=ldaps://dc01.example.internal:636
LDAP_SEARCH_BASE=ou=People,dc=example,dc=internal
LDAP_BIND_DN=cn=svc-mail,ou=Service Accounts,dc=example,dc=internal
LDAP_BIND_PW=
LDAP_QUERY_FILTER_USER=(&(objectClass=user)(mail=%s))
LDAP_QUERY_FILTER_GROUP=(&(objectClass=group)(mail=%s))
LDAP_QUERY_FILTER_ALIAS=(&(objectClass=user)(proxyAddresses=smtp:%s))
LDAP_QUERY_FILTER_DOMAIN=(mail=*@%s)

# Dovecot-side LDAP settings (empty = inherit from LDAP_* above).
DOVECOT_TLS=
DOVECOT_USER_FILTER=(&(objectClass=user)(mail=%u))
DOVECOT_PASS_FILTER=(&(objectClass=user)(mail=%u))
# yes = verify passwords by binding as the user (no password hashes needed).
DOVECOT_AUTH_BIND=yes


# -----------------------------------------------------------------------------
# 14. SASLauthd (alternative SMTP auth backend) - off
# -----------------------------------------------------------------------------
ENABLE_SASLAUTHD=0
SASLAUTHD_MECHANISMS=
SASLAUTHD_MECH_OPTIONS=
SASLAUTHD_LDAP_SERVER=
SASLAUTHD_LDAP_BIND_DN=
SASLAUTHD_LDAP_PASSWORD=
SASLAUTHD_LDAP_SEARCH_BASE=
SASLAUTHD_LDAP_FILTER=
SASLAUTHD_LDAP_START_TLS=
SASLAUTHD_LDAP_TLS_CHECK_PEER=yes
SASLAUTHD_LDAP_TLS_CACERT_FILE=
SASLAUTHD_LDAP_TLS_CACERT_DIR=
SASLAUTHD_LDAP_PASSWORD_ATTR=
SASLAUTHD_LDAP_AUTH_METHOD=
SASLAUTHD_LDAP_MECH=


# -----------------------------------------------------------------------------
# 15. OAuth2 / OIDC (needs a reachable IdP introspection endpoint) - off
# -----------------------------------------------------------------------------
ENABLE_OAUTH2=
OAUTH2_INTROSPECTION_URL=


# -----------------------------------------------------------------------------
# 16. Offline update hooks (read by config/user-patches.sh, not by DMS)
# -----------------------------------------------------------------------------
# Internal HTTP(S) mirror serving main.cvd/daily.cvd/bytecode.cvd. Leave empty
# to disable freshclam and update signatures manually (instructions §8).
CLAMAV_PRIVATE_MIRROR=

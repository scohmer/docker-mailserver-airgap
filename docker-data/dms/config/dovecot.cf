# docker-mailserver: Dovecot overrides
# DMS copies this file to /etc/dovecot/local.conf (loaded last, so it wins over
# the TLS_LEVEL defaults DMS writes into conf.d/10-ssl.conf).
# Syntax: Dovecot 2.4 (DMS v16+, Debian 13). Dovecot 2.3 syntax will NOT load.

# ---- TLS: FIPS-approved only (ECDHE + AES-GCM, P-384/P-256) ----
ssl = required
ssl_min_protocol = TLSv1.2
ssl_cipher_list = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
ssl_cipher_suites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256
ssl_curve_list = P-384:P-256
ssl_server_prefer_ciphers = server
ssl_options = no_ticket

# ---- Authentication ----
# Never allow cleartext auth without TLS (replaces 2.3 disable_plaintext_auth)
auth_allow_cleartext = no
auth_mechanisms = plain login

# ---- Misc hardening ----
login_greeting = Mail server ready.
mail_max_userip_connections = 20

# Disable the plaintext/STARTTLS IMAP listener entirely; only 993 remains.
service imap-login {
  inet_listener imap {
    port = 0
  }
}

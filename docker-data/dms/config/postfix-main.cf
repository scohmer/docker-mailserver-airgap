# docker-mailserver: Postfix overrides (applied line by line with postconf at start-up)
# FIPS-approved TLS only - defense in depth on top of /etc/ssl/openssl.cnf

# ---- Protocols: TLS 1.2+ only ----
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2

# ---- FIPS-approved suites only (ECDHE + AES-GCM). No CHACHA20, no CBC, no DHE ----
tls_high_cipherlist = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
smtp_tls_ciphers = high
smtp_tls_mandatory_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, eNULL, EXPORT, DES, 3DES, RC4, MD5, PSK, SRP, CAMELLIA, ARIA, SEED, IDEA, CHACHA20, SHA1
smtp_tls_exclude_ciphers = aNULL, eNULL, EXPORT, DES, 3DES, RC4, MD5, PSK, SRP, CAMELLIA, ARIA, SEED, IDEA, CHACHA20, SHA1
tls_preempt_cipherlist = yes
tls_eecdh_auto_curves = secp384r1 prime256v1
tls_ssl_options = NO_COMPRESSION, NO_RENEGOTIATION

# ---- Digests ----
smtpd_tls_fingerprint_digest = sha256
smtp_tls_fingerprint_digest = sha256

# ---- Outbound TLS ----
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
# Raise to "encrypt" (or "secure") once every internal peer MTA/relay has a PKI cert
smtp_tls_security_level = may

# ---- Inbound ----
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_auth_only = yes
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_banner = $myhostname ESMTP
